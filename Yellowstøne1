<script>
var PAIRS={"EUR/USD":{p:1.0850,pip:.0001,d:5},"GBP/USD":{p:1.2900,pip:.0001,d:5},"USD/JPY":{p:149.50,pip:.01,d:3},"USD/KES":{p:129.20,pip:.01,d:2},"AUD/USD":{p:.6600,pip:.0001,d:5},"USD/CAD":{p:1.3600,pip:.0001,d:5},"USD/CHF":{p:.8800,pip:.0001,d:5},"EUR/JPY":{p:162.20,pip:.01,d:3}};
var FEED_URL="/api/price",target={},feedErr=false,SPREAD=1.2,pairSel="EUR/USD",tab="open",bal=10000,open=[],pend=[],alerts=[],lines=[],closed=[],nid=1,hist={},start={};
Object.keys(PAIRS).forEach(function(k){hist[k]=[];var x=PAIRS[k].p;for(var i=0;i<3000;i++){x+=(Math.random()-.5)*PAIRS[k].pip*3;hist[k].push(x)}start[k]=hist[k][0]});
function $(i){return document.getElementById(i)}
function mid(k){var h=hist[k];return h[h.length-1]}
function bid(k){return mid(k)-PAIRS[k].pip*SPREAD/2}
function ask(k){return mid(k)+PAIRS[k].pip*SPREAD/2}
function fmt(k,v){return v.toFixed(PAIRS[k].d)}
function money(v){return (v<0?"-":"")+"$"+Math.abs(v).toLocaleString("en-US",{minimumFractionDigits:2,maximumFractionDigits:2})}
function pipVal(k){var q=k.split("/")[1];return q==="USD"?10:PAIRS[k].pip*100000/mid("USD/"+q)}
function pnl(t){var pp=PAIRS[t.pair].pip,pips=t.side==="buy"?(bid(t.pair)-t.entry)/pp:(t.entry-ask(t.pair))/pp;return{pips:pips,usd:pips*pipVal(t.pair)*t.lots}}
function margin(l){return l*1000}
function lotsVal(){var v=parseFloat($("lots").value);return isNaN(v)?0:Math.min(5,Math.max(0,v))}
function say(t){$("msg").textContent=t;clearTimeout(say.h);if(t)say.h=setTimeout(function(){$("msg").textContent=""},6000)}
function trade(side){
  if(FEED_URL&&target[pairSel]===undefined){say("Waiting for the live price. Try again in a moment.");return}
  var l=lotsVal();if(l<.01){say("Enter a lot size of at least 0.01.");return}
  var used=open.reduce(function(a,t){return a+margin(t.lots)},0);
  if(equity()-used<margin(l)){say("Not enough free margin. Lower the lot size or close a trade.");return}
  var k=pairSel,pp=PAIRS[k].pip,s=parseFloat($("sl").value),t=parseFloat($("tp").value),px=parseFloat($("pr").value);
  if(px>0){var cur=side==="buy"?ask(k):bid(k);
    if(Math.abs(px-cur)<pp){say("Entry price is too close to the current price. Leave it blank for a market order.");return}
    pend.push({id:nid++,pair:k,side:side,lots:l,price:px,ge:px>cur,s:s>0?s:0,t:t>0?t:0});say("Pending order placed. It fills when the price reaches it.");save();render();return}
  fill(k,side,l,s,t);say("");render();
}
function fill(k,side,l,s,t){var pp=PAIRS[k].pip,e=side==="buy"?ask(k):bid(k),dir=side==="buy"?1:-1;
  open.push({id:nid++,pair:k,side:side,lots:l,entry:e,sl:s>0?e-dir*s*pp:null,tp:t>0?e+dir*t*pp:null});save()}
function close(id,why){
  var i=open.findIndex(function(t){return t.id===id});if(i<0)return;
  var t=open.splice(i,1)[0],r=pnl(t);bal+=r.usd;
  save();closed.unshift({pair:t.pair,side:t.side,lots:t.lots,pips:r.pips,usd:r.usd,why:why||"Closed by you"});
}
function equity(){return bal+open.reduce(function(a,t){return a+pnl(t).usd},0)}
function toast(t){var e=$("toast");e.textContent=t;e.style.display="block";clearTimeout(toast.h);toast.h=setTimeout(function(){e.style.display="none"},4500)}
async function exportCsv(){
  var txt=["pair,side,lots,pips,profit_usd,result"].concat(closed.map(function(t){return [t.pair,t.side,t.lots,t.pips.toFixed(1),t.usd.toFixed(2),t.why].join(",")})).join("\n");
  try{
    if(typeof claude!=="undefined"){var dl=await claude.use("downloads");if(dl){await dl.save({filename:"forex-practice-trades.csv",data:txt});return}}
    var a=document.createElement("a");a.href=URL.createObjectURL(new Blob([txt],{type:"text/csv"}));a.download="forex-practice-trades.csv";document.body.appendChild(a);a.click();a.remove();
  }catch(e){if(!e||e.code!=="declined")toast("Couldn't export the file.")}
}
function tick(){
  Object.keys(PAIRS).forEach(function(k){var h=hist[k],pp=PAIRS[k].pip,m=h[h.length-1];
    if(FEED_URL){if(target[k]===undefined)return;m+=(target[k]-m)*.3}else m+=(Math.random()+Math.random()+Math.random()-1.5)*pp*1.6;h.push(m);if(h.length>3000)h.shift()});
  alerts.slice().forEach(function(a){if(FEED_URL&&target[a.pair]===undefined)return;var m=mid(a.pair);if(a.ge?m>=a.price:m<=a.price){alerts.splice(alerts.indexOf(a),1);toolsDirty=true;toast("Alert: "+a.pair+" reached "+fmt(a.pair,a.price));try{navigator.vibrate&&navigator.vibrate(200)}catch(e){}save()}});
  pend.slice().forEach(function(o){if(FEED_URL&&target[o.pair]===undefined)return;var hit=o.side==="buy"?(o.ge?ask(o.pair)>=o.price:ask(o.pair)<=o.price):(o.ge?bid(o.pair)>=o.price:bid(o.pair)<=o.price);
    if(!hit)return;pend.splice(pend.indexOf(o),1);
    var u=open.reduce(function(a,t){return a+margin(t.lots)},0);
    if(equity()-u<margin(o.lots)){say("A pending order was cancelled: not enough free margin.");save();return}
    fill(o.pair,o.side,o.lots,o.s,o.t);toast("Pending order filled on "+o.pair+".")});
  open.slice().forEach(function(t){if(FEED_URL&&target[t.pair]===undefined)return;var b=bid(t.pair),a=ask(t.pair);
    if(t.tr&&t.sl!==null){if(t.side==="buy"){var n1=b-t.td;if(n1>t.sl)t.sl=n1}else{var n2=a+t.td;if(n2<t.sl)t.sl=n2}}
    if(t.side==="buy"){if(t.sl!==null&&b<=t.sl)close(t.id,"Stop-loss hit");else if(t.tp!==null&&b>=t.tp)close(t.id,"Take-profit hit")}
    else{if(t.sl!==null&&a>=t.sl)close(t.id,"Stop-loss hit");else if(t.tp!==null&&a<=t.tp)close(t.id,"Take-profit hit")}});
  var mu=open.reduce(function(a,t){return a+margin(t.lots)},0);
  if(mu&&equity()/mu<.5&&!(FEED_URL&&open.some(function(t){return target[t.pair]===undefined}))){open.slice().forEach(function(t){close(t.id,"Margin stop-out")});say("Stop-out: margin level fell below 50%, so all trades were closed.")}
  render();
}
function render(){
  var k=pairSel,o=open.reduce(function(a,t){return a+pnl(t).usd},0);
  $("bal").textContent=money(bal);$("eq").textContent=money(bal+o);
  $("pl").textContent=money(o);$("pl").className=o>=0?"up":"down";
  $("mid").textContent=fmt(k,mid(k));
  var ch=(mid(k)-start[k])/PAIRS[k].pip;$("chg").textContent=(ch>=0?"+":"")+ch.toFixed(1)+" pips";$("chg").className=ch>=0?"up":"down";
  $("bid").textContent=fmt(k,bid(k));$("ask").textContent=fmt(k,ask(k));
  $("mg").value=money(margin(lotsVal()));
  var mu=open.reduce(function(a,t){return a+margin(t.lots)},0),E=bal+o;
  $("mu").textContent=money(mu);$("fm").textContent=money(E-mu);$("ml").textContent=mu?Math.round(E/mu*100)+"%":"–";
  $("rsi").textContent="RSI "+Math.round(rsi(k));
  draw();panel();
}
var TF=67,editId=null,smaOn=true,toolsDirty=true,resetArm=false;
function candles(k){var d=hist[k],out=[];for(var e=d.length;e>0&&out.length<70;e-=TF){var g=d.slice(Math.max(0,e-TF),e);out.unshift({o:g[0],c:g[g.length-1],h:Math.max.apply(0,g),l:Math.min.apply(0,g)})}return out}
function draw(){
  var c=$("c"),r=window.devicePixelRatio||1,w=c.clientWidth,h=c.clientHeight;
  if(c.width!==w*r){c.width=w*r;c.height=h*r}
  var x=c.getContext("2d");x.setTransform(r,0,0,r,0,0);x.clearRect(0,0,w,h);
  var all=candles(pairSel),cs=all.slice(-48),pp=PAIRS[pairSel].pip,mn=Math.min.apply(0,cs.map(function(q){return q.l}))-pp*2,mx=Math.max.apply(0,cs.map(function(q){return q.h}))+pp*2;
  var Y=function(v){return h-(v-mn)/(mx-mn)*h},st=getComputedStyle(document.documentElement),up=st.getPropertyValue("--up").trim()||"#14936b",dn=st.getPropertyValue("--down").trim()||"#d03b4f",bw=w/48;
  cs.forEach(function(q,i){var X=(48-cs.length+i)*bw+bw/2,col=q.c>=q.o?up:dn;
    x.strokeStyle=col;x.fillStyle=col;x.lineWidth=1;x.beginPath();x.moveTo(X,Y(q.h));x.lineTo(X,Y(q.l));x.stroke();
    var t=Y(Math.max(q.o,q.c)),b=Y(Math.min(q.o,q.c));x.fillRect(X-bw*.35,t,bw*.7,Math.max(1.5,b-t))});
  if(smaOn){x.beginPath();var go=false;cs.forEach(function(q,i){var gi=all.length-cs.length+i;if(gi<19)return;var m=0;for(var j=gi-19;j<=gi;j++)m+=all[j].c;m/=20;var X=(48-cs.length+i)*bw+bw/2;go?x.lineTo(X,Y(m)):x.moveTo(X,Y(m));go=true});x.strokeStyle=st.getPropertyValue("--buy").trim()||"#1f6feb";x.lineWidth=1.5;x.stroke()}
  var last=mid(pairSel);x.setLineDash([2,3]);x.strokeStyle=st.getPropertyValue("--mute").trim()||"#888";x.beginPath();x.moveTo(0,Y(last));x.lineTo(w,Y(last));x.stroke();x.setLineDash([]);
  open.filter(function(t){return t.pair===pairSel}).forEach(function(t){
    [[t.entry,"#888"],[t.sl,"#d03b4f"],[t.tp,"#14936b"]].forEach(function(l){if(l[0]===null||l[0]<mn||l[0]>mx)return;
      x.beginPath();x.setLineDash([5,4]);x.moveTo(0,Y(l[0]));x.lineTo(w,Y(l[0]));x.strokeStyle=l[1];x.lineWidth=1;x.stroke();x.setLineDash([])})});
  pend.filter(function(o){return o.pair===pairSel&&o.price>=mn&&o.price<=mx}).forEach(function(o){x.beginPath();x.setLineDash([2,4]);x.moveTo(0,Y(o.price));x.lineTo(w,Y(o.price));x.strokeStyle="#e4761b";x.lineWidth=1.5;x.stroke();x.setLineDash([])});
  lines.filter(function(o){return o.pair===pairSel&&o.price>=mn&&o.price<=mx}).forEach(function(o){x.beginPath();x.moveTo(0,Y(o.price));x.lineTo(w,Y(o.price));x.strokeStyle=st.getPropertyValue("--mute").trim()||"#888";x.lineWidth=1;x.stroke()});
}
function rsi(k){var a=candles(k),g=0,l=0,n=Math.min(14,a.length-1);if(n<2)return 50;for(var i=a.length-n;i<a.length;i++){var d=a[i].c-a[i-1].c;if(d>0)g+=d;else l-=d}return l===0?100:100-100/(1+g/l)}
function editForm(t){var pp=PAIRS[t.pair].pip;return '<div class="ed"><div><label>Stop-loss (pips from entry)</label><input id="es" type="number" min="1" inputmode="numeric" value="'+(t.sl!==null?Math.round(Math.abs(t.entry-t.sl)/pp):"")+'"></div><div><label>Take-profit (pips from entry)</label><input id="et" type="number" min="1" inputmode="numeric" value="'+(t.tp!==null?Math.round(Math.abs(t.tp-t.entry)/pp):"")+'"></div><label style="grid-column:1/3"><input type="checkbox" id="etr" style="width:auto" '+(t.tr?"checked":"")+'> Trailing stop (follows the price at the stop-loss distance)</label><button data-es="'+t.id+'">Save</button><button data-ec="1">Cancel</button></div>'}
function panel(force){
  var p=$("panel"),h="";
  if(editId!==null&&!open.some(function(t){return t.id===editId}))editId=null;
  if(!force&&tab==="open"&&editId!==null)return;
  if(tab==="open"){
    if(!open.length)h='<p class="empty">No open trades. Pick Buy if you expect the price to rise, Sell if you expect it to fall.</p>';
    open.forEach(function(t){var r=pnl(t);h+='<div class="pos"><div><b>'+t.side.toUpperCase()+" "+t.pair+'</b><small>'+t.lots.toFixed(2)+" lots at "+fmt(t.pair,t.entry)+'</small></div><div style="text-align:right"><b class="'+(r.usd>=0?"up":"down")+'">'+money(r.usd)+'</b><small>'+r.pips.toFixed(1)+' pips</small></div><div class="bt"><button data-e="'+t.id+'">Edit</button><button data-c="'+t.id+'">Close</button></div></div>'+(editId===t.id?editForm(t):"")});
    if(open.length>1)h+='<button class="closeall" data-all="1">Close all trades</button>';
    if(pend.length){h+='<p class="empty" style="margin-top:10px">Pending orders</p>';pend.forEach(function(o){h+='<div class="pos"><div><b>'+o.side.toUpperCase()+' '+((o.side==="buy")===o.ge?"STOP":"LIMIT")+' '+o.pair+'</b><small>'+o.lots.toFixed(2)+' lots at '+fmt(o.pair,o.price)+'</small></div><button data-x="'+o.id+'">Cancel</button></div>'})}
  }else if(tab==="hist"){
    if(!closed.length)h='<p class="empty">Closed trades will appear here.</p>';else h='<p class="empty">Win rate '+Math.round(closed.filter(function(t){return t.usd>0}).length/closed.length*100)+'% · '+closed.length+' trades</p>';
    closed.slice(0,30).forEach(function(t){h+='<div class="pos"><div><b>'+t.side.toUpperCase()+" "+t.pair+'</b><small>'+t.lots.toFixed(2)+" lots · "+t.why+'</small></div><div style="text-align:right"><b class="'+(t.usd>=0?"up":"down")+'">'+money(t.usd)+'</b><small>'+t.pips.toFixed(1)+' pips</small></div></div>'});
  }else if(tab==="tools"){
